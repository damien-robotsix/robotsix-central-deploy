# Edge configuration for docker-compose.yml. Copy to `.env` (git-ignored) and
# fill in. Only the Traefik edge and tinyauth read these — central-deploy's own
# config still lives entirely in /data/config.json (see docs/deployment.md).
#
# Nothing deployment-specific is committed to this repo, so every value below
# has to be supplied here.

# --- Fleet domain -----------------------------------------------------------
# Components are published at <component-id>.<GATEWAY_BASE_DOMAIN>, and the
# wildcard certificate covers that domain plus *.that-domain.
#
# MUST match central-deploy's own `gateway_base_domain` setting, which is what
# the routing labels are derived from. If the two disagree, components get
# routes for a hostname the certificate does not cover.
GATEWAY_BASE_DOMAIN=deploy.example.net

# --- ACME / TLS -------------------------------------------------------------
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# OVH API credentials with DNS write on the zone, for the DNS-01 wildcard
# challenge. Create at https://api.ovh.com/createToken/ with:
#   GET/POST/DELETE  /domain/zone/<your-zone>/*
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# --- tinyauth (fleet SSO) ---------------------------------------------------
# Session-signing secret; exactly 32 characters. Generate with:
#   openssl rand -hex 16
TINYAUTH_SECRET=

# Operator login, as user:bcrypt-hash. Generate with:
#   htpasswd -nbB <username> '<password>'
# Compose expands `$`, so double every `$` in the hash: `$2y$05$…` → `$$2y$$05$$…`
TINYAUTH_AUTH_USERS=
