# Edge secrets for docker-compose.yml. Copy to `.env` (git-ignored) and fill in.
# Only the Traefik edge and tinyauth read these — central-deploy's own config
# still lives entirely in /data/config.json (see docs/deployment.md).

# --- ACME / TLS -------------------------------------------------------------
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# OVH API credentials with DNS write on the zone, for the DNS-01 wildcard
# challenge. Create at https://api.ovh.com/createToken/ with:
#   GET/POST/DELETE  /domain/zone/robotsix.net/*
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# --- tinyauth (fleet SSO) ---------------------------------------------------
# Session-signing secret; exactly 32 characters. Generate with:
#   openssl rand -hex 16
TINYAUTH_SECRET=

# Operator login, as user:bcrypt-hash. Generate with:
#   htpasswd -nbB <username> '<password>'
# Compose expands `$`, so double every `$` in the hash: `$2y$05$…` → `$$2y$$05$$…`
TINYAUTH_AUTH_USERS=
