# tinyauth SSO credentials. Copy to `tinyauth.env` (git-ignored) and fill in.
#
# Compose reads this file with `format: raw`, meaning NO interpolation: write
# values exactly as generated. In particular a bcrypt hash keeps its single
# `$` characters — do not double them.

# Session-signing secret; exactly 32 characters. Generate with:
#   openssl rand -hex 16
TINYAUTH_SECRET=

# Operator login, as user:bcrypt-hash. Generate with:
#   htpasswd -nbB <username> '<password>'
TINYAUTH_AUTH_USERS=
